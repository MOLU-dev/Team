# === Environment files (anywhere in tree) ===
**/.env
**/.env.*
**/app.env
!**/.env.example
!**/.env.local.example
!**/.env.*.example
!**/app.env.example

# === Database files (anywhere) ===
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
**/*.sqlite-journal
**/*.pgdata/
**/data/

!**/*_test.db
!**/testdata/
!**/fixtures/

# === Protobuf / generated code ===
# Ignore all generated by default
**/*.pb.go
**/*.pb.gw.go
**/*.pb.validate.go
**/*.pb.json.go
**/*.pb.ts
**/*.pb.js

# Whitelist committed generated code (adjust paths to your repo)
!**/api/gen/**/*.pb.go
!**/pkg/proto/gen/**/*.pb.go

# Still ignore scratch / temp gen dirs
**/gen/tmp/
**/gen/temp/
**/generated/

# === Vault / secrets (local dev only) ===
**/.vault/
**/vault/data/
**/vault/file/
**/vault/logs/
**/*.vault-token
**/*.hclic
**/*.agekey
**/secrets/
**/secret/

# Keep example certs and test fixtures
!**/*.example.key
!**/*.example.crt
!**/testdata/
!**/fixtures/

# === IDE / OS ===
.idea/
.vscode/
*.swp
*.swo
*~
